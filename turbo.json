{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["scripts/typecheck.js", "tsconfig.json"],
  "globalPassThroughEnv": ["CI"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**"]
    }
  }
}
