{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": ["react", "react-native", "jest"],
    "composite": true
  },
  "include": ["**/*.ts", "**/*.tsx", "mf-modules.d.ts"],
  "exclude": ["node_modules", "android", "ios", "build"]
}
