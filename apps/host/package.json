{
  "name": "host",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "react-native start --port 8081",
    "android": "expo run:android --no-bundler",
    "ios": "expo run:ios --no-bundler",
    "prebuild": "expo prebuild",
    "typecheck": "node ../../scripts/typecheck.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js"
  },
  "dependencies": {
    "@microapps/shared": "*",
    "@microapps/uniwind-rspack": "*",
    "@module-federation/enhanced": "2.5.0",
    "@react-navigation/native": "7.1.14",
    "@react-navigation/native-stack": "7.3.21",
    "expo": "~56.0.3",
    "expo-constants": "~56.0.0",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.12.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-transform-dynamic-import": "^7.29.7",
    "@callstack/repack": "5.2.5",
    "@callstack/repack-plugin-expo-modules": "5.2.5",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@rozenite/network-activity-plugin": "^2.4.0",
    "@rozenite/react-navigation-plugin": "^2.4.0",
    "@rozenite/repack": "^2.4.0",
    "@rspack/core": "^1.4.11",
    "@swc/core": "^1.11.24",
    "@swc/helpers": "0.5.17",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "test-renderer": "~1.2.0",
    "typescript": "~5.9.2"
  }
}
